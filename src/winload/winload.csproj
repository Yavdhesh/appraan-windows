<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Winload</RootNamespace>
    <AssemblyName>winload</AssemblyName>
    <Description>Known-workload generator (loopback TCP + temp-file I/O) used to verify winscope counts on Windows.</Description>
  </PropertyGroup>

</Project>
