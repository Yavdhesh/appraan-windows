<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Appraanagent</RootNamespace>
    <AssemblyName>appraanagent</AssemblyName>
    <Description>The Appraan sidecar: hosts the ops, TCP-life and off-CPU trackers in ONE kernel ETW session for one PID and publishes a JSON snapshot file that Appraan (Java) polls as its Windows kernel collector, via Appraan.Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Appraan.Windows\Appraan.Windows.csproj" />
  </ItemGroup>

</Project>
